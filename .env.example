# .env.example — Contrato Visto (backend serverless). Copie para .env e ajuste.
# Ambiente LOCAL usa adapters MOCK e Postgres em Docker. NÃO coloque segredos reais aqui.

# ── Banco (PostgreSQL 18 local via docker cv-pg18, role de app não-owner) ──
DB_HOST=localhost
DB_PORT=5433
DB_USER=cv_app
DB_PASS=localdev_cv
DB_NAME=contrato_visto
# timeouts opcionais (ms)
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=15000

# ── Aplicação / Auth ──
ENVIRONMENT=local            # local | dev | staging | production (production bloqueia mocks)
LOG_LEVEL=INFO
JWT_SECRET_KEY=troque-este-segredo-local   # HS256; use um valor forte fora do local
JWT_TTL_HOURS=8
MAX_BODY_BYTES=1048576       # 1 MB (corpo JSON; upload de arquivo vai por presigned)

# ── Dev-server local (tools/local_server.py) ──
HOST=127.0.0.1
PORT=8000

# ── Backends de serviço (LOCAL = mock; AWS/real só na Fase 7) ──
STORAGE_BACKEND=mock         # mock | s3
EMAIL_BACKEND=mock           # mock | ses
EMAIL_FROM=no-reply@contratovisto.local
OCR_BACKEND=mock             # mock | textract
EMBEDDINGS_BACKEND=mock      # mock | openai | bedrock
EMBEDDINGS_MODEL=text-embedding-3-small
AI_ANALYSIS_BACKEND=mock     # mock | (real = NotImplemented nesta fase)
AI_ANALYSIS_PROVIDER=mock
CNJ_BACKEND=mock
ESCAVADOR_BACKEND=mock
SERASA_BACKEND=mock

# ── Storage / Fila (valores reais vêm do deploy/SSM na AWS) ──
DOCUMENTS_BUCKET=contrato-visto-documents-local
PRESIGNED_EXPIRES=900        # segundos
QUEUE_BACKEND=inline         # inline (dev) | sqs (AWS)
DOCUMENT_PROCESSING_QUEUE_URL=
DOCUMENT_PROCESSING_MAX_ATTEMPTS=3
AWS_REGION=sa-east-1

# ── Chaves de APIs externas (DEIXE VAZIO no local; só preencher em ambiente seguro) ──
OPENAI_TIMEOUT=10
OPENAI_MAX_RETRIES=2
AI_ANALYSIS_API_KEY=
CNJ_API_KEY=
ESCAVADOR_API_KEY=
SERASA_API_KEY=
